#!/bin/sh
# Repository structure gate. Tracked at 00_global/scripts/hooks/pre-commit;
# enabled with:  git config core.hooksPath 00_global/scripts/hooks
#
# Validates the INDEX, not the working tree. Those differ whenever staging is
# partial, and it is the index that becomes the commit.

set -eu

root=$(git rev-parse --show-toplevel)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/mfds-structure.XXXXXX")
trap 'rm -rf "$tmp"' EXIT INT TERM

git checkout-index --all --prefix="$tmp/"

status=0
python3 "$root/00_global/scripts/validate_structure.py" --root "$tmp" || status=$?

case "$status" in
  0) exit 0 ;;
  2) echo "validate_structure.py: schema bug - the validator is broken, not the repo" >&2 ;;
  *) echo "structure findings above are not in the baseline; commit aborted" >&2
     echo "  accept them:  ./00_global/scripts/validate_structure.py --write-baseline" >&2
     echo "  bypass once:  git commit --no-verify" >&2 ;;
esac
exit 1
